# Bu dosyayı .env olarak kopyalayıp doldur. Vercel'de aynı adlarla ortam değişkeni olarak ver.

# https://developer.pubg.com adresinden alınan PUBG API anahtarı (zorunlu)
PUBG_API_KEY=

# League of Legends için Riot API anahtarı (https://developer.riotgames.com). Yoksa LoL bölümü kapalı kalır.
# Geliştirici anahtarları 24 saatte bir sona erer; kalıcı kullanım için "Personal API Key" başvurusu yap.
RIOT_API_KEY=

# /streamers yönetici sayfasının şifresi. Yerelde boş bırakılırsa data/admin-password.txt'ye üretilir.
ADMIN_PASSWORD=

# GitHub Actions'ın otomatik bulma turunu çağırırken kullandığı gizli anahtar (sadece Vercel'de gerekli)
CRON_SECRET=

# Android uygulamasının imza parmak izi (SHA-256). Yerelde android/keystore/sha256.txt'den okunur.
# Play App Signing kullanılıyorsa Google'ın parmak izini virgülle ekle.
TWA_SHA256=

# Vercel Blob deposunu projeye bağlayınca Vercel bunu kendisi ekler
# BLOB_READ_WRITE_TOKEN=
