{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/.well-known/assetlinks.json",
      "destination": "/api/index?__path=/.well-known/assetlinks.json"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index?__path=/api/:path*"
    },
    {
      "source": "/players/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/streamers",
      "destination": "/index.html"
    },
    {
      "source": "/lol",
      "destination": "/index.html"
    },
    {
      "source": "/lol/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "regions": [
    "fra1"
  ]
}
